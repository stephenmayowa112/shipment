# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- WhatsApp Business Cloud API Settings ---
# TODO: Get credentials from Meta for Developers (developers.facebook.com) > WhatsApp > API Setup
WHATSAPP_API_TOKEN="EAABxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="109876543210123"
WHATSAPP_BUSINESS_ACCOUNT_ID="123456789098765"
WHATSAPP_VERIFY_TOKEN="shiptrack_webhook_secret_verify_token_2026"
WHATSAPP_API_VERSION="v20.0"

# --- Database & Background Queue (Django + Celery) ---
DATABASE_URL="postgres://shiptrack_user:password@localhost:5432/shiptrack_db"
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# --- Admin Credentials (V1 Single-Admin Authentication) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="shiptrack_secure_pass_2026"
ADMIN_SECRET_KEY="django-insecure-shiptrack-crossborder-logistics-key"

